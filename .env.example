# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kernel?retryWrites=true&w=majority

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Google SMTP Email Configuration
GMAIL_USERNAME=niyas36et@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password

# Admin Configuration
ADMIN_PASSWORD=your-secure-admin-password

# JWT Secret (auto-generated if not set, but set for production)
