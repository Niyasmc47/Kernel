# ==============================================================================
# KERNEL Backend Environment Variables (Azure App Service Configuration)
# Set these in Azure Portal -> App Service -> Configuration -> Application Settings
# ==============================================================================

# Server Port (Azure App Service automatically injects PORT=80 or PORT=8080)
PORT=8080

# MongoDB Database Connection (e.g. MongoDB Atlas free tier cluster M0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kernel_db?retryWrites=true&w=majority

# Google Gemini AI Studio API Key (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Command Center Admin Key (Used to authenticate at /admin)
ADMIN_PASSWORD=your_secure_admin_passcode

# Security JWT Secret (256-bit secret string for token signing)
JWT_SECRET=super_secure_random_256_bit_secret_string_for_production

# Gmail SMTP Email Dispatch (To receive alerts & voice note recordings)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GMAIL_USERNAME=niyas36et@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# Cross-Origin Resource Sharing (CORS) & Frontend Binding
# Add your Vercel URL and local development URLs (comma-separated or wildcard pattern)
FRONTEND_URL=https://<your-vercel-app>.vercel.app
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app,https://*.vercel.app,http://localhost:3000

